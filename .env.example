# ============================================================
# KSE — Environment variables example
# Copy to .env per app / deployment target.
# NEVER commit real secrets.
# ============================================================

# ---------- Mobile (apps/mobile) ----------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
# Google Sign-In Web OAuth client ID (public value). The client secret belongs
# only in the Supabase dashboard → Authentication → Providers → Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---------- Admin (apps/admin) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Backend / Edge Functions (supabase/functions) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
SENTRY_DSN=
# Expo push notifications
EXPO_ACCESS_TOKEN=
