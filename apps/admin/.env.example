# Supabase project used by the admin panel.
# Copy to apps/admin/.env.local for local dev, or set these in Vercel
# (Project → Settings → Environment Variables) for deployment.
#
# The URL and publishable key are public by design — they ship in the
# browser bundle. The service-role key is a real secret: server-only,
# never commit the real value (CLAUDE.md §10/§26).
NEXT_PUBLIC_SUPABASE_URL=https://ssnrgvgmiwonmurwqqkk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_uNDpIqt4VTlTDaIwnUHf-Q_Q4V-bJBa
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me
